# ─────────────────────────────────────────────────────────────────────────────
# Шаблон переменных окружения портала «Правовой маршрут».
# Скопируйте в .env и заполните значения. Файл .env не публикуется в git.
# ─────────────────────────────────────────────────────────────────────────────

# ─── База данных (обязательно) ───────────────────────────────────────────────
# SQLite: файл рядом с проектом. На сервере укажите абсолютный путь.
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ─── Адрес сайта (обязательно на production) ────────────────────────────────
# Используется для canonical, sitemap.xml, robots.txt, Open Graph и JSON-LD.
# Без этого значения в метаданных будет хост запроса (localhost при локальном
# запуске). На production задайте реальный домен:
#SITE_URL=https://вашдомен.ru
# Тот же адрес можно задать в админ-панели («Настройки» → «Адрес сайта») —
# значение из админки имеет приоритет над переменной окружения.

# ─── Название сайта в теме писем (необязательно) ────────────────────────────
#SITE_NAME=Правовой маршрут

# ─── Загрузка изображений (необязательно) ───────────────────────────────────
#MAX_UPLOAD_MB=5
#UPLOAD_DIR=./uploads

# ─── Уведомления о обращениях на e-mail (необязательно) ─────────────────────
# Пока SMTP не настроен: обращения сохраняются в БД и видны в
# /admin/submissions, посетитель видит честное сообщение об этом.
# Настройка для Яндекс.Почты — см. docs/EMAIL-SMTP.md.
#
# Сервер исходящей почты:
#SMTP_HOST=smtp.yandex.ru
#SMTP_PORT=465
# Ящик, от имени которого отправляются письма (обычно совпадает с SMTP_USER):
#SMTP_FROM=documentonline.direct@yandex.ru
# Логин SMTP — тот же ящик:
#SMTP_USER=documentonline.direct@yandex.ru
# Пароль SMTP — НЕ основной пароль, а «пароль приложения», созданный
# в настройках Яндекс.Почты (Безопасность → Пароли приложений). Никому
# не показывайте его и не публикуйте.
#SMTP_PASSWORD=
# Адрес получателя обращений (может совпадать с SMTP_USER):
#FEEDBACK_TO_EMAIL=documentonline.direct@yandex.ru
